      "year": "2026",
      "license": "MIT",
      "priority": 4,
      "recommended": true,
      "framework": "PyTorch / segmentation-models-pytorch",
      "resource_profile": "normal",
      "datasets": ["ISIC 2018 Task 1"],
      "checkpoint_status": "public_verified",
      "integration_status": "ready_after_setup",
