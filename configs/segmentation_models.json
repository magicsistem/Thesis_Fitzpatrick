{
  "models": [
    {
      "id": "avit",
      "name": "AViT",
      "year": "2023",
      "license": "No declarada",
      "priority": 1,
      "recommended": true,
      "framework": "PyTorch",
      "resource_profile": "normal/pesado",
      "datasets": ["ISIC 2018", "Dermofit", "SCD", "PH2"],
      "checkpoint_status": "public_verified",
      "integration_status": "ready_after_setup",
      "repository": "https://github.com/siyi-wind/AViT",
      "description": "Transformer con checkpoint ISIC publicado y verificado. Es el comparador de mayor tamaño y sirve para contrastar precisión frente a tiempo y RAM en CPU.",
      "adapter_command": [
        "{conda}", "run", "--no-capture-output", "-n", "thesis-avit", "python",
        "{repo_root}/scripts/adapters/avit.py", "--image", "{image}", "--output", "{lesion_mask}",
        "--source", "{repo_root}/models/avit/source", "--checkpoint",
        "{repo_root}/models/avit/checkpoints/AViT_ViT_B_ISIC_best.pth", "--device", "cpu"
      ]
    },
    {
      "id": "ultralight-vm-unet",
